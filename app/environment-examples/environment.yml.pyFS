channels:
  - conda-forge
  # We want to have a reproducible setup, so we don't want default channels,
  # which may be different for different users. All required channels should
  # be listed explicitly here.
  - nodefaults
dependencies:
  - python=3.12
  - ipykernel
  - matplotlib
  - psycopg2
  - shiny
  - scipy
  - jinja2
  - sphinx
  - jupyter-sphinx
  - sphinx-book-theme
  - pip
  - pip:
    - apscheduler
    - aioredis
    - faicons
    - pytabulator
    - myst_parser
    - nbsphinx
    - ./src_python
    