app_init_lock_path = '/tmp/app-init.lock'
redis_app_lock_var = 'APP_INIT_LOCK'
LOCK_TIMEOUT = 60  # seconds

def signal_handler():
    print(f"Received signal, stopping...")
    sys.exit(0)
    
    
